PYTHONPATH=__INSTALL_DIR__


MEDIA_ROOT=__DATA_DIR__/media
STATIC_ROOT=__INSTALL_DIR__/static

ALLOWED_HOSTS=__DOMAIN__

SECRET_KEY=__SECRET_KEY__

SIGNING_KEY=__SIGNING_KEY__

TIME_ZONE=Europe/Berlin
TZ=Europe/Berlin

MEDIA_URL=https://__DOMAIN__/media/
STATIC_URL=https://__DOMAIN__/static/

WGER_INSTANCE=https://__DOMAIN__
ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=True
ALLOW_UPLOAD_VIDEOS=True

MIN_ACCOUNT_AGE_TO_TRUST=21

SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=True
SYNC_EXERCISE_VIDEOS_CELERY=True

SYNC_INGREDIENTS_CELERY=True

DOWNLOAD_INGREDIENTS_FROM=WGER

CACHE_API_EXERCISES_CELERY=True

CACHE_API_EXERCISES_CELERY_FORCE_UPDATE=False

USE_CELERY=True

CELERY_BROKER=redis://127.0.0.1:6379/__REDIS_DB__
CELERY_BACKEND=redis://127.0.0.1:6379/__REDIS_DB__
CELERY_FLOWER_PASSWORD=adminadmin
CELERY_WORKER_CONCURRENCY=4

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=__DB_NAME__
DJANGO_DB_USER=__DB_USER__
DJANGO_DB_PASSWORD=__DB_PWD__
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
DJANGO_PERFORM_MIGRATIONS=True # Perform any new database migrations on startup

DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/__REDIS_DB__
DJANGO_CACHE_TIMEOUT=1296000 # in seconds - 60*60*24*15, 15 Days
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient

AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30 # in minutes
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler
AXES_LOCKOUT_PARAMETERS=ip_address
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_META_PRECEDENCE_ORDER=HTTP_X_FORWARDED_FOR,REMOTE_ADDR

DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
EXERCISE_CACHE_TTL=18000 # in seconds - 5*60*60, 5 hours
SITE_URL=https://__DOMAIN__

ACCESS_TOKEN_LIFETIME=10 # The lifetime duration of the access token, in minutes
REFRESH_TOKEN_LIFETIME=24 # The lifetime duration of the refresh token, in hours

AUTH_PROXY_HEADER=''
AUTH_PROXY_TRUSTED_IPS=''
AUTH_PROXY_CREATE_UNKNOWN_USER=False
AUTH_PROXY_USER_EMAIL_HEADER=''
AUTH_PROXY_USER_NAME_HEADER=''

LOG_LEVEL_PYTHON=INFO

USE_RECAPTCHA=False

DJANGO_CLEAR_STATIC_FIRST=False

ENABLE_EMAIL=True
EMAIL_HOST=__DOMAIN__
EMAIL_PORT=587
EMAIL_HOST_USER=__APP__
EMAIL_HOST_PASSWORD=__MAIL_PWD__
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
FROM_EMAIL='wger Workout Manager <__APP__@__DOMAIN__>'

NUMBER_OF_PROXIES=1

GUNICORN_CMD_ARGS="--workers 3 --threads 2 --worker-class gthread --timeout 240"

EXPOSE_PROMETHEUS_METRICS=False